+func TestDirCredentials(t *testing.T) {
+	dir := t.TempDir()
+	write := func(name, val string) {
+		require.NoError(t, os.WriteFile(filepath.Join(dir, name), []byte(val), 0o600))
+	}
+	var cfg Config
+	require.NoError(t, cfg.SetFromURL(&url.URL{Scheme: "s3", Host: "bucket", RawQuery: "credentials_dir=" + dir}, ""))
+	require.IsType(t, &aws.CredentialsCache{}, cfg.CredentialsProvider)
+
+	_, err := cfg.CredentialsProvider.Retrieve(t.Context())
+	require.Error(t, err, "missing files")
+
+	write("access_key_id", "AK1\n")
+	write("secret_access_key", "SK1")
+	write("session_token", "ST1")
+	write("expiration", "2030-01-02T03:04:05Z")
+	creds, err := dirCredentials(dir).Retrieve(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, "AK1", creds.AccessKeyID)
+	require.Equal(t, "SK1", creds.SecretAccessKey)
+	require.Equal(t, "ST1", creds.SessionToken)
+	require.Equal(t, time.Date(2030, 1, 2, 2, 59, 5, 0, time.UTC), creds.Expires.UTC())
+
+	// Static keys: no session token, no expiration -> re-read in 30 minutes.
+	require.NoError(t, os.Remove(filepath.Join(dir, "session_token")))
+	require.NoError(t, os.Remove(filepath.Join(dir, "expiration")))
+	creds, err = dirCredentials(dir).Retrieve(t.Context())
+	require.NoError(t, err)
+	require.Empty(t, creds.SessionToken)
+	require.WithinDuration(t, time.Now().Add(30*time.Minute), creds.Expires, time.Minute)
+
+	write("expiration", "tomorrow")
+	_, err = dirCredentials(dir).Retrieve(t.Context())
+	require.Error(t, err)
+
+	// Kubernetes Secret layout: top-level names are symlinks into ..data, which
+	// is itself a symlink to a timestamped directory. A rotation swaps ..data;
+	// all files must come from the generation ..data pointed at, not from a
+	// mix of the old top-level links and the new directory.
+	mount := t.TempDir()
+	gen := filepath.Join(mount, "..2026_10_21")
+	require.NoError(t, os.Mkdir(gen, 0o700))
+	for name, val := range map[string]string{"access_key_id": "GEN", "secret_access_key": "SECRET"} {
+		require.NoError(t, os.WriteFile(filepath.Join(gen, name), []byte(val), 0o600))
+	}
+	require.NoError(t, os.Symlink("..2026_10_21", filepath.Join(mount, "..data")))
+	require.NoError(t, os.WriteFile(filepath.Join(mount, "access_key_id"), []byte("STALE"), 0o600))
+	creds, err = dirCredentials(mount).Retrieve(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, "GEN", creds.AccessKeyID)
+}
