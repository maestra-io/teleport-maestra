+// dirCredentials reads access_key_id, secret_access_key and the optional
+// session_token and expiration (RFC3339) from files in a directory, e.g. a
+// mounted Kubernetes Secret that Vault Secrets Operator rewrites with fresh
+// temporary R2 credentials. Wrapped in aws.CredentialsCache it re-reads the
+// files 5 minutes before expiration, or every 30 minutes without one.
+// maestra patch.
+type dirCredentials string
+
+func (d dirCredentials) Retrieve(context.Context) (aws.Credentials, error) {
+	// A mounted Secret is a set of symlinks into a timestamped directory behind
+	// the ..data link; kubelet swaps that one link atomically on rotation.
+	// Resolve it once so every file comes from the same Secret generation.
+	dir := string(d)
+	if resolved, err := filepath.EvalSymlinks(filepath.Join(dir, "..data")); err == nil {
+		dir = resolved
+	}
+	read := func(name string) (string, error) {
+		b, err := os.ReadFile(filepath.Join(dir, name))
+		return strings.TrimSpace(string(b)), err
+	}
+	creds := aws.Credentials{Source: credentialsDirParam, CanExpire: true, Expires: time.Now().Add(30 * time.Minute)}
+	var err error
+	if creds.AccessKeyID, err = read("access_key_id"); err != nil {
+		return aws.Credentials{}, trace.ConvertSystemError(err)
+	}
+	if creds.SecretAccessKey, err = read("secret_access_key"); err != nil {
+		return aws.Credentials{}, trace.ConvertSystemError(err)
+	}
+	if creds.AccessKeyID == "" || creds.SecretAccessKey == "" {
+		return aws.Credentials{}, trace.BadParameter("empty access_key_id or secret_access_key in %s", string(d))
+	}
+	if creds.SessionToken, err = read("session_token"); err != nil && !os.IsNotExist(err) {
+		return aws.Credentials{}, trace.ConvertSystemError(err)
+	}
+	if exp, _ := read("expiration"); exp != "" {
+		t, err := time.Parse(time.RFC3339, exp)
+		if err != nil {
+			return aws.Credentials{}, trace.BadParameter("invalid expiration in %s: %v", string(d), err)
+		}
+		creds.Expires = t.Add(-5 * time.Minute)
+	}
+	return creds, nil
+}
